@article{hamisPracticalIntroductionODE2026,
  title = {A Practical Introduction to {{ODE}} Modelling in {{Stan}} for Biological Systems},
  author = {Hamis, Sara and Forslund, John and Gu, Cici Chen and Cochrane, Jodie A.},
